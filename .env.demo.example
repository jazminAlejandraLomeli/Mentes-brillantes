# ============================================================
#  .env para la DEMO en Hostinger (ej. https://demo.tudominio.com)
#  Cópialo en el servidor como .env y llena lo que dice CAMBIAR.
# ============================================================

APP_NAME="Mentes Brillantes by Liz"
APP_ENV=production
APP_KEY=                       # se llena solo con: php artisan key:generate
APP_DEBUG=false
APP_TIMEZONE=America/Mexico_City
APP_URL=https://demo.tudominio.com      # CAMBIAR: tu subdominio, con https

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

# Modo demo: aviso arriba, acceso visible en el login y reinicio cada noche.
# ¡NUNCA lo pongas en true en el sitio real de un cliente!
APP_DEMO=true

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Base de datos creada en hPanel → Bases de datos MySQL
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u000000000_demo     # CAMBIAR
DB_USERNAME=u000000000_demo     # CAMBIAR
DB_PASSWORD=                    # CAMBIAR

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# En la demo no hace falta enviar correos (se guardan en el log)
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-responder@tudominio.com"
MAIL_FROM_NAME="Mentes Brillantes"

VITE_APP_NAME="${APP_NAME}"

# Usuario de la demo (se muestra en el login para que cualquiera pueda entrar)
ADMIN_NAME="Liz"
ADMIN_EMAIL=demo@mentesbrillantes.com
ADMIN_PASSWORD=demo1234
